<UserControl x:Class="MlbbOverlay.Views.EditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,0,0,1" Padding="16,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox Content="Test mode (dummy data)" IsChecked="{Binding TestMode}"
                              VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Button Content="Play in OBS" Style="{StaticResource SmallButton}" Height="32"
                            Command="{Binding PlayInObsCommand}"/>
                    <Button Content="Save" Style="{StaticResource SmallButton}" Height="32" Margin="8,0,0,0"
                            Command="{Binding SaveCommand}"/>
                    <Button Content="Save and Continue" Style="{StaticResource AccentButton}" Height="32"
                            Margin="8,0,0,0" Command="{Binding SaveAndContinueCommand}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Back" Style="{StaticResource SmallButton}" Height="32"
                            Command="{Binding BackCommand}"/>
                    <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="Bold" Margin="16,0,0,0"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Key}" Style="{StaticResource MutedText}" Margin="10,0,0,0"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Message}" Foreground="#F5A623" Margin="16,0,0,0"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <wv2:WebView2 Grid.Row="1" x:Name="Browser"/>
    </Grid>
</UserControl>