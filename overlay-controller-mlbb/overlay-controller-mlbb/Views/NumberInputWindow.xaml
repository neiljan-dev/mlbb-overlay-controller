<Window x:Class="MlbbOverlay.Views.NumberInputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Input" Width="380" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}">
    <StackPanel Margin="24">
        <TextBlock x:Name="Label1Text" Style="{StaticResource MutedText}"/>
        <TextBox x:Name="Box1" Height="34" Margin="0,4,0,12" VerticalContentAlignment="Center"/>

        <StackPanel x:Name="SecondPanel">
            <TextBlock x:Name="Label2Text" Style="{StaticResource MutedText}"/>
            <TextBox x:Name="Box2" Height="34" Margin="0,4,0,12" VerticalContentAlignment="Center"/>
        </StackPanel>

        <TextBlock x:Name="ErrorText" Foreground="#FF6B6B" TextWrapping="Wrap" Margin="0,0,0,8"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Style="{StaticResource SmallButton}" Click="Cancel_Click"/>
            <Button Content="OK" Style="{StaticResource AccentButton}" IsDefault="True"
                    Margin="8,0,0,0" Click="Ok_Click"/>
        </StackPanel>
    </StackPanel>
</Window>