<UserControl x:Class="MlbbOverlay.Views.TeamSetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <Button Content="Back" Command="{Binding BackCommand}" Style="{StaticResource SmallButton}"/>
            <TextBlock Text="Team Setup" Style="{StaticResource TitleText}"
                       Margin="20,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Profile + series format -->
        <Grid Grid.Row="1" Margin="0,20,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Profile" Style="{StaticResource MutedText}"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ComboBox Width="240" Height="34" VerticalContentAlignment="Center"
                          ItemsSource="{Binding Profiles}" DisplayMemberPath="Name"
                          SelectedItem="{Binding SelectedProfile}"/>
                <Button Content="New" Command="{Binding NewProfileCommand}"
                        Style="{StaticResource SmallButton}" Margin="8,0,0,0"/>
                <Button Content="Delete" Command="{Binding DeleteProfileCommand}"
                        Style="{StaticResource SmallButton}" Margin="8,0,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <TextBlock Text="Series" Style="{StaticResource MutedText}"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ComboBox Width="100" Height="34" VerticalContentAlignment="Center"
                          ItemsSource="{Binding Formats}" SelectedItem="{Binding Format}"/>
            </StackPanel>
        </Grid>

        <!-- The two team panels (each drawn by TeamEditorView) -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ContentControl Grid.Column="0" Content="{Binding Team1}" VerticalAlignment="Top"/>
                <ContentControl Grid.Column="2" Content="{Binding Team2}" VerticalAlignment="Top"/>
            </Grid>
        </ScrollViewer>

        <!-- Bottom bar -->
        <Grid Grid.Row="3" Margin="0,16,0,0">
            <TextBlock Text="{Binding ErrorText}" Foreground="#FF6B6B" VerticalAlignment="Center"/>
            <Button Content="Proceed" Command="{Binding ProceedCommand}"
                    Style="{StaticResource AccentButton}" HorizontalAlignment="Right" MinWidth="140"/>
        </Grid>
    </Grid>
</UserControl>