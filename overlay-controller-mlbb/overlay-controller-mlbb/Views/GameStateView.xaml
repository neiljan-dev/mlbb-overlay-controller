<UserControl x:Class="MlbbOverlay.Views.GameStateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="StateButton" TargetType="Button" BasedOn="{StaticResource SmallButton}">
            <Setter Property="Height" Value="46"/>
            <Setter Property="Margin" Value="3"/>
        </Style>
    </UserControl.Resources>

    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}"
            BorderThickness="1" CornerRadius="12" Padding="18">
        <StackPanel>

            <!-- Header with the state switch at the top right -->
            <DockPanel>
                <ComboBox DockPanel.Dock="Right" Width="130" Height="32" VerticalContentAlignment="Center"
                          ItemsSource="{Binding States}" DisplayMemberPath="Label"
                          SelectedValuePath="Value" SelectedValue="{Binding SelectedState}"/>
                <TextBlock Text="2   GAME STATE" FontSize="16" FontWeight="Bold"
                           Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
            </DockPanel>

            <!-- Draft Pick -->
            <StackPanel Margin="0,14,0,0"
                        Visibility="{Binding IsDraft, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="The draft overlay is on screen. Choose heroes on the left."
                           Style="{StaticResource MutedText}" TextWrapping="Wrap"/>
                <Button Content="Show draft overlay again" Style="{StaticResource StateButton}"
                        Margin="0,10,0,0" Command="{Binding ShowDraftOverlayCommand}"/>
            </StackPanel>

            <!-- Ingame -->
            <StackPanel Margin="0,14,0,0"
                        Visibility="{Binding IsIngame, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="Events follow the queue settings (Settings button)." Style="{StaticResource MutedText}"/>
                <UniformGrid Columns="2" Margin="0,8,0,0">
                    <Button Content="Turtle slain" Style="{StaticResource StateButton}" Command="{Binding TurtleSlainCommand}"/>
                    <Button Content="Lord slain" Style="{StaticResource StateButton}" Command="{Binding LordSlainCommand}"/>
                    <Button Content="Turtle spawn" Style="{StaticResource StateButton}" Command="{Binding TurtleSpawnCommand}"/>
                    <Button Content="Lord spawn" Style="{StaticResource StateButton}" Command="{Binding LordSpawnCommand}"/>
                    <Button Content="Kill" Style="{StaticResource StateButton}" Command="{Binding KillCommand}"/>
                    <Button Content="Victory" Style="{StaticResource StateButton}" Command="{Binding VictoryCommand}"/>
                </UniformGrid>
            </StackPanel>

            <!-- Postgame -->
            <StackPanel Margin="0,14,0,0"
                        Visibility="{Binding IsPostgame, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="The overlay stays until you change state or press another button."
                           Style="{StaticResource MutedText}" TextWrapping="Wrap"/>
                <Button Content="Result" Style="{StaticResource StateButton}" Margin="3,10,3,3" Command="{Binding ResultCommand}"/>
                <Button Content="MVP" Style="{StaticResource StateButton}" Command="{Binding MvpCommand}"/>
                <Button Content="Status (score)" Style="{StaticResource StateButton}" Command="{Binding StatusCommand}"/>
            </StackPanel>

            <!-- Neiljan (ads) -->
            <StackPanel Margin="0,14,0,0"
                        Visibility="{Binding IsNeiljan, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="Ads stay on screen until you change state or press another ad."
                           Style="{StaticResource MutedText}" TextWrapping="Wrap"/>
                <Button Content="Ad 1 (timer)" Style="{StaticResource StateButton}" Margin="3,10,3,3" Command="{Binding Ad1Command}"/>
                <Button Content="Ad 2 (timer)" Style="{StaticResource StateButton}" Command="{Binding Ad2Command}"/>
                <Button Content="Ad 3 (loop)" Style="{StaticResource StateButton}" Command="{Binding Ad3Command}"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>