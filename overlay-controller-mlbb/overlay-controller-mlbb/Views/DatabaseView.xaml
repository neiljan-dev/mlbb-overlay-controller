<UserControl x:Class="MlbbOverlay.Views.DatabaseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="8,0"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <Button Content="Back" Command="{Binding BackCommand}" Style="{StaticResource SmallButton}"/>
            <TextBlock Text="Database" Style="{StaticResource TitleText}"
                       Margin="20,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Toolbar -->
        <Grid Grid.Row="1" Margin="0,20,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Search" Style="{StaticResource MutedText}"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox Width="320" Height="34" VerticalContentAlignment="Center"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Test picker" Command="{Binding TestPickerCommand}"
                        Style="{StaticResource SmallButton}"/>
                <Button Content="Import folder..." Command="{Binding ImportFolderCommand}"
                        Style="{StaticResource SmallButton}" Margin="8,0,0,0"/>
                <Button Content="+ Add hero" Command="{Binding AddHeroCommand}"
                        Style="{StaticResource AccentButton}" Margin="8,0,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Hero list -->
        <DataGrid Grid.Row="2" ItemsSource="{Binding Heroes}"
                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                  CanUserResizeColumns="False" HeadersVisibility="Column"
                  SelectionMode="Single" RowHeight="56" GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="" Width="64">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Width="44" Height="44" CornerRadius="6" Margin="8,0"
                                    Background="{StaticResource BgBrush}">
                                <Image Stretch="Uniform"
                                       Source="{Binding IconFile, Converter={StaticResource FileImage}, ConverterParameter=hero|88}"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"
                                    ElementStyle="{StaticResource CellText}"/>
                <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="130"
                                    ElementStyle="{StaticResource CellText}"/>
                <DataGridTextColumn Header="Splash" Binding="{Binding SplashStatus}" Width="80"
                                    ElementStyle="{StaticResource CellText}"/>
                <DataGridTextColumn Header="Full body" Binding="{Binding FullBodyStatus}" Width="90"
                                    ElementStyle="{StaticResource CellText}"/>

                <DataGridTemplateColumn Header="" Width="180">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                <Button Content="Edit" Style="{StaticResource SmallButton}" MinWidth="64"
                                        Command="{Binding DataContext.EditHeroCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"/>
                                <Button Content="Delete" Style="{StaticResource SmallButton}" MinWidth="64"
                                        Margin="8,0,0,0"
                                        Command="{Binding DataContext.DeleteHeroCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Shown only when the list is empty -->
        <TextBlock Grid.Row="2" Text="No heroes yet. Click &quot;+ Add hero&quot; or &quot;Import folder...&quot;."
                   HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Heroes.Count}" Value="0">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <TextBlock Grid.Row="3" Text="{Binding StatusText}" Style="{StaticResource MutedText}" Margin="0,10,0,0"/>
    </Grid>
</UserControl>