<Window x:Class="MlbbOverlay.Views.HeroEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}" Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}">
    <Window.Resources>
        <!-- How one image field (icon / splash / full body) looks -->
        <DataTemplate x:Key="SlotTemplate">
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="112"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Width="96" Height="96" CornerRadius="8" BorderThickness="1"
                        Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}">
                    <Image Margin="4" Stretch="Uniform"
                           Source="{Binding PreviewPath, Converter={StaticResource FileImage}, ConverterParameter=path|192}"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Hint}" Style="{StaticResource MutedText}"
                               TextWrapping="Wrap" Margin="0,2,0,8"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Browse..." Style="{StaticResource SmallButton}"
                                Command="{Binding DataContext.BrowseCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"/>
                        <Button Content="Clear" Style="{StaticResource SmallButton}" Margin="8,0,0,0"
                                Command="{Binding DataContext.ClearCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <StackPanel Margin="28">
        <TextBlock Text="Name" Style="{StaticResource MutedText}"/>
        <TextBox Height="34" Margin="0,4,0,14" VerticalContentAlignment="Center"
                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Text="Role" Style="{StaticResource MutedText}"/>
        <ComboBox Height="34" Margin="0,4,0,20" VerticalContentAlignment="Center"
                  ItemsSource="{Binding Roles}" SelectedItem="{Binding Role}"/>

        <ContentControl Content="{Binding Icon}" ContentTemplate="{StaticResource SlotTemplate}"/>
        <ContentControl Content="{Binding Splash}" ContentTemplate="{StaticResource SlotTemplate}"/>
        <ContentControl Content="{Binding FullBody}" ContentTemplate="{StaticResource SlotTemplate}"/>

        <TextBlock Text="{Binding ErrorText}" Foreground="#FF6B6B" TextWrapping="Wrap" Margin="0,0,0,10"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Command="{Binding CancelCommand}" Style="{StaticResource SmallButton}"/>
            <Button Content="Save" Command="{Binding SaveCommand}" IsDefault="True"
                    Style="{StaticResource AccentButton}" Margin="8,0,0,0"/>
        </StackPanel>
    </StackPanel>
</Window>