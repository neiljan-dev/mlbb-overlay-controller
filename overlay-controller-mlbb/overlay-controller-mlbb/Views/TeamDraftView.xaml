<UserControl x:Class="MlbbOverlay.Views.TeamDraftView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>

        <!-- The "+" shown while a slot has no icon -->
        <Style x:Key="PlusText" TargetType="TextBlock">
            <Setter Property="Text" Value="+"/>
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IconFile}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Square pick slot -->
        <Style x:Key="PickSlotButton" TargetType="Button">
            <Setter Property="Width" Value="64"/>
            <Setter Property="Height" Value="64"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{StaticResource BgBrush}"
                                BorderBrush="{StaticResource LineBrush}" BorderThickness="2"
                                CornerRadius="8" ClipToBounds="True">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Round ban slot -->
        <Style x:Key="BanSlotButton" TargetType="Button">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="Ring" Fill="{StaticResource BgBrush}"
                                     Stroke="{StaticResource LineBrush}" StrokeThickness="2"/>
                            <ContentPresenter/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10"
            Padding="14" Margin="0,14,0,0">
        <StackPanel>
            <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="Bold"
                       Foreground="{StaticResource AccentBrush}"/>

            <!-- Pick = 2/3 of the width, Ban = 1/3 -->
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- PICK -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="PICK" Style="{StaticResource MutedText}" Margin="0,0,0,6"/>
                    <ItemsControl ItemsSource="{Binding Picks}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="3,0">
                                    <Button Style="{StaticResource PickSlotButton}"
                                            Command="{Binding PickCommand}"
                                            ToolTip="Click: choose a hero. Right-click: clear the slot.">
                                        <Button.InputBindings>
                                            <MouseBinding MouseAction="RightClick" Command="{Binding ClearCommand}"/>
                                        </Button.InputBindings>
                                        <Grid>
                                            <TextBlock Style="{StaticResource PlusText}"/>
                                            <Image Stretch="UniformToFill"
                                                   Source="{Binding IconFile, Converter={StaticResource FileImage}, ConverterParameter=hero|128}"/>
                                        </Grid>
                                    </Button>
                                    <TextBlock Text="{Binding Ign}" FontSize="13" FontWeight="SemiBold"
                                               TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,6,0,0"/>
                                    <TextBlock Text="{Binding HeroName}" Style="{StaticResource MutedText}"
                                               FontSize="12" TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- BAN -->
                <StackPanel Grid.Column="2">
                    <TextBlock Text="BAN" Style="{StaticResource MutedText}" Margin="0,0,0,6"/>
                    <ItemsControl ItemsSource="{Binding Bans}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource BanSlotButton}"
                                        Command="{Binding PickCommand}"
                                        ToolTip="Click: choose a hero. Right-click: clear the slot.">
                                    <Button.InputBindings>
                                        <MouseBinding MouseAction="RightClick" Command="{Binding ClearCommand}"/>
                                    </Button.InputBindings>
                                    <Grid>
                                        <TextBlock Style="{StaticResource PlusText}" FontSize="20"/>
                                        <Ellipse Margin="3">
                                            <Ellipse.Fill>
                                                <ImageBrush Stretch="UniformToFill"
                                                            ImageSource="{Binding IconFile, Converter={StaticResource FileImage}, ConverterParameter=hero|96}"/>
                                            </Ellipse.Fill>
                                        </Ellipse>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>