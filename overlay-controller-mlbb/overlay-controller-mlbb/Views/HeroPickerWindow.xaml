<Window x:Class="MlbbOverlay.Views.HeroPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose a hero" Width="760" Height="620"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FocusManager.FocusedElement="{Binding ElementName=SearchBox}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBox x:Name="SearchBox" Height="36" VerticalContentAlignment="Center"
                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>

        <ScrollViewer Grid.Row="1" Margin="0,12" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Heroes}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource TileButton}" Width="104"
                                Command="{Binding DataContext.PickCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}">
                            <StackPanel>
                                <Border Width="72" Height="72" CornerRadius="8" HorizontalAlignment="Center"
                                        Background="{StaticResource BgBrush}">
                                    <Image Stretch="Uniform"
                                           Source="{Binding IconFile, Converter={StaticResource FileImage}, ConverterParameter=hero|144}"/>
                                </Border>
                                <TextBlock Text="{Binding Name}" FontSize="12" TextAlignment="Center"
                                           TextTrimming="CharacterEllipsis" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Button Grid.Row="2" Content="Cancel" Command="{Binding CancelCommand}"
                Style="{StaticResource SmallButton}" HorizontalAlignment="Right"/>
    </Grid>
</Window>