<Window x:Class="MlbbOverlay.Views.TeamChoiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}" Width="640" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}">
    <StackPanel Margin="24">
        <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="Bold"/>

        <Grid Margin="0,16,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Style="{StaticResource SmallButton}" Height="190"
                    Tag="{Binding Left.TeamIndex}" Click="Team_Click">
                <StackPanel>
                    <Image Width="90" Height="90" Stretch="Uniform"
                           Source="{Binding Left.LogoFile, Converter={StaticResource FileImage}, ConverterParameter=logo|180}"/>
                    <TextBlock Text="{Binding Left.SideText}" Foreground="{Binding Left.SideColor}"
                               FontWeight="Bold" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    <TextBlock Text="{Binding Left.Name}" FontSize="20" FontWeight="SemiBold"
                               HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                </StackPanel>
            </Button>

            <Button Grid.Column="2" Style="{StaticResource SmallButton}" Height="190"
                    Tag="{Binding Right.TeamIndex}" Click="Team_Click">
                <StackPanel>
                    <Image Width="90" Height="90" Stretch="Uniform"
                           Source="{Binding Right.LogoFile, Converter={StaticResource FileImage}, ConverterParameter=logo|180}"/>
                    <TextBlock Text="{Binding Right.SideText}" Foreground="{Binding Right.SideColor}"
                               FontWeight="Bold" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    <TextBlock Text="{Binding Right.Name}" FontSize="20" FontWeight="SemiBold"
                               HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <Button Content="Cancel" Style="{StaticResource SmallButton}" HorizontalAlignment="Right"
                Click="Cancel_Click"/>
    </StackPanel>
</Window>