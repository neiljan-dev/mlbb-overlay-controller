<UserControl x:Class="MlbbOverlay.Views.PlaceholderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="32">
        <Button Content="Back" Command="{Binding BackCommand}" Style="{StaticResource SmallButton}"
                HorizontalAlignment="Left" VerticalAlignment="Top"/>

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="{Binding Title}" Style="{StaticResource TitleText}"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding Message}" Style="{StaticResource MutedText}"
                       HorizontalAlignment="Center" Margin="0,8,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>