<Window x:Class="MlbbOverlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MLBB Overlay Controller"
        Width="1280" Height="720" MinWidth="1000" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Status bar -->
        <Border Grid.Row="0" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="16,6">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="OBS and Server..."
                        Command="{Binding OpenConnectionCommand}"
                        Style="{StaticResource SmallButton}" Height="28"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Style="{StaticResource ObsDot}" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding Obs.StatusText}" Style="{StaticResource MutedText}"/>
                    <TextBlock Text="|" Style="{StaticResource MutedText}" Margin="12,0"/>
                    <TextBlock Text="{Binding Server.StatusText}" Style="{StaticResource MutedText}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Current screen -->
        <ContentControl Grid.Row="1" Content="{Binding Navigator.CurrentViewModel}"/>
    </Grid>
</Window>