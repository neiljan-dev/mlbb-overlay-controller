<Application x:Class="MlbbOverlay.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MlbbOverlay.ViewModels"
             xmlns:views="clr-namespace:MlbbOverlay.Views"
             xmlns:conv="clr-namespace:MlbbOverlay.Converters"
             ThemeMode="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Dark.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <conv:FileNameToImageConverter x:Key="FileImage"/>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>

            <!-- "When you see this ViewModel, draw this View" -->
            <DataTemplate DataType="{x:Type vm:MainMenuViewModel}">
                <views:MainMenuView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:PlaceholderViewModel}">
                <views:PlaceholderView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:DatabaseViewModel}">
                <views:DatabaseView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:TeamSetupViewModel}">
                <views:TeamSetupView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:TeamEditorViewModel}">
                <views:TeamEditorView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ControllerViewModel}">
                <views:ControllerView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:HeroSelectionViewModel}">
                <views:HeroSelectionView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:TeamDraftViewModel}">
                <views:TeamDraftView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:GameStateViewModel}">
                <views:GameStateView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:OverlayTesterViewModel}">
                <views:OverlayTesterView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:DesignListViewModel}">
                <views:DesignListView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:EditorViewModel}">
                <views:EditorView/>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>